#!/usr/bin/env bash

set -e

export LC_ALL=C

SCRIPT_DIR=$( cd -- "$( dirname -- "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )
ROOT_DIR="$SCRIPT_DIR/../.."

cd "$ROOT_DIR"

######################

echo "Check existence of GitHub actions workflow"

WORKFLOWS=$(find '.github/workflows/' \
  -name '*.yml' -o -name '*.yaml' \
  | grep -v -e '\.github/workflows/autograde\.yaml$' \
            -e '\.github/workflows/shellcheck\.yml$')
echo "$WORKFLOWS"

[[ -n "$WORKFLOWS" ]] \
  || (echo "No workflow found except for autograde.yaml and shellcheck.yml" && exit 1)
